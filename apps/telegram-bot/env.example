# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Logging Configuration
RUST_LOG=info

# Verification Mode: "mock" (default) or "blockchain"
VERIFICATION_MODE=mock

# Optimism RPC URL (only needed for blockchain mode)
OPTIMISM_RPC_URL=https://optimism-rpc.publicnode.com

# Holonym Hub Contract Address
HUB_CONTRACT_ADDRESS=0x2AA822e264F8cc31A2b9C22f39e5551241e94DfB

# Ethereum Mainnet RPC URL (for ENS resolution)
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com

# HTTP API (used by the browser extension for Twitter-handle lookups)
# Bind to loopback by default; set 0.0.0.0 only when you mean to expose it.
API_BIND=127.0.0.1
API_PORT=3141

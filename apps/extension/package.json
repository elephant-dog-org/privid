{
  "name": "privid-extension",
  "version": "1.0.0",
  "description": "Privacy-preserving identity verification browser extension using zero-knowledge proofs.",
  "author": "elephant-dog-org",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elephant-dog-org/privid.git"
  },
  "keywords": ["browser-extension", "privacy", "identity", "zero-knowledge", "privid"],
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@atproto/api": "^0.15.19",
    "ethers": "^5.7.2",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@typechain/ethers-v5": "11.1.2",
    "@types/webextension-polyfill": "^0.12.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "terser": "^5.31.0",
    "typechain": "^8.3.2",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "web-ext": "^8.8.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.popup.config.ts --logLevel silent && vite build --config vite.content.config.ts --logLevel silent && vite build --config vite.gmail.config.ts --logLevel silent",
    "preview": "vite preview",
    "typechain": "typechain --target ethers-v5 --out-dir blockchain/typechain blockchain/abis/*.json",
    "package-extension": "sh scripts/package-extension.sh",
    "test": "vitest run",
    "test:utils": "bun run test-utils.ts",
    "test:utils:run": "./run-tests.sh",
    "example:utils": "bun run example-usage.ts"
  }
}
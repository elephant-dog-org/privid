{
  "manifest_version": 3,
  "name": "PrivID Extension",
  "version": "1.0",
  "description": "Privacy-preserving identity verification using zero-knowledge proofs.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://bsky.app/profile/*"],
      "js": ["dist/content/injectBadge.js"],
      "css": ["dist/content/injectBadge.css"]
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["dist/content/gmail/injectGmailBadge.js"],
      "css": ["dist/content/gmail/injectGmailBadge.css"]
    },
    {
      "matches": ["https://twitter.com/*", "https://x.com/*"],
      "js": ["dist/content/twitter/injectTwitterBadge.js"],
      "css": ["dist/content/twitter/injectTwitterBadge.css"],
      "run_at": "document_idle"
    }
  ]
}